{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables default permissions plus HTTP and CORS fetch",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "cors-fetch:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost"
        }
      ],
      "deny": []
    },
    "http:allow-fetch",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send"
  ]
}