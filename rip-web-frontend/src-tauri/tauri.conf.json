{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rip-web-frontend-NEW",
  "version": "0.2.0", 
  "identifier": "tree.rip-web-frontend-new",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://172.20.10.7:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "http": {
      "enabled": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "rip-web-frontend",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}